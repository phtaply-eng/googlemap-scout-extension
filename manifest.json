{
  "manifest_version": 3,
  "name": "Taply Scout — Google Maps Scraper",
  "version": "1.0.0",
  "description": "Scrape any Google Maps business (no website = hot lead), export MD/TXT & copy color-themed landing page prompts. By TapVinci.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Taply Scout — Get Info",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://www.google.com.ph/maps/*",
    "https://www.google.com.sg/maps/*",
    "https://www.google.co.uk/maps/*",
    "https://www.google.co.in/maps/*",
    "https://www.google.com.au/maps/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://www.google.com.ph/maps/*",
        "https://www.google.com.sg/maps/*",
        "https://www.google.co.uk/maps/*",
        "https://www.google.co.in/maps/*",
        "https://www.google.com.au/maps/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
